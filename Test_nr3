import socket

# Gebruik "0.0.0.0" zodat hij luistert op alle netwerkadapters van je PC, 
# of vul het vaste IP-adres van je PC in (bijv. "192.168.1.50")
HOST = "192.168.106.199" 
PORT = 5000  # Kies een vrije poort (bijv. 5000)

server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
# Voorkomt de foutmelding "Address already in use" als je het script opnieuw start
server_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)

server_socket.bind((HOST, PORT))
server_socket.listen(1)

print(f"Server gestart! Luistert naar de robot op poort {PORT}...")

try:
    while True:
        # Wacht tot de robot een verbinding maakt
        conn, addr = server_socket.accept()
        print(f"Verbinding gemaakt met robot op IP: {addr[0]}")

        # Ontvang de data van de robot (maximaal 1024 bytes)
        data = conn.recv(1024).decode("utf-8").strip()

        if data:
            print(f"SUCCES! Ontvangen van robot: '{data}'")
            # Hier kun je eventueel actie ondernemen in Python, zoals data opslaan
        
        # Sluit de verbinding met de robot voor deze actie
        conn.close()

except KeyboardInterrupt:
    print("\nServer gestopt door gebruiker.")

finally:
    server_socket.close()